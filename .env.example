# 必填：阿里云百炼 DashScope API Key。不要提交真实值。
DASHSCOPE_API_KEY=replace-with-your-api-key

# 可选：多模态模型与音频配置
OMNI_API_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
OMNI_MODEL=qwen3-omni-flash-realtime
OMNI_VOICE=Cherry
AUDIO_INPUT_DEVICE=pulse

# 可选：ROS 图像桥接
ROSBRIDGE_URL=ws://127.0.0.1:9090
CAMERA_IMAGE_TOPIC=/zed/zed_node/rgb/color/rect/image/compressed
CAMERA_IMAGE_FPS=2.0

# 可选：运行行为
BLIND_NAV_DEBUG=false
STARTUP_ANNOUNCEMENT=true
